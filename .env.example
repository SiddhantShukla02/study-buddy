# Copy this file to a new file named exactly `.env` (same folder), then fill in the values.
# `.env` is git-ignored: never commit it, never paste its contents anywhere public.
# Leave BEDROCK_MODEL_ID empty (or have no .env at all) to run fully offline in keyword mode.
#
# Restart `python server.py` after editing: the file is read once at startup.

# --- Amazon Bedrock (optional: LLM agent in the simulator + AI flashcards)
# The inference profile ID (NOT the ARN) from Bedrock > Infer > Inference profiles.
BEDROCK_MODEL_ID=
# The region where that profile works (must match your console region).
AWS_REGION=ap-southeast-2
# A Bedrock API key (Bedrock > API keys). Temporary keys expire: when it does, paste a fresh one here.
AWS_BEARER_TOKEN_BEDROCK=

